# YALNIZCA yerel geliştirme. Parolaları kendiniz belirleyin, .env dosyasını git'e eklemeyin.
LOGSCOPE_DB_PASSWORD=change_this_local_database_password
LOGSCOPE_DEMO_PASSWORD=change_this_local_demo_password
LOGSCOPE_DEMO_MODE=1
LOGSCOPE_HTTPS=0
# 0 = SQLite ile hızlı başlangıç; 1 = Docker PostgreSQL'e bağlan
LOGSCOPE_USE_POSTGRES=0
# Django anomali test uç noktaları sadece localhost yük testi için açılır
LOGSCOPE_ENABLE_ANOMALY_ENDPOINTS=0
LOGSCOPE_DJANGO_SECRET=change_this_django_local_secret_key
# Only allow your trusted local development origins for session-cookie POSTs.
LOGSCOPE_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
