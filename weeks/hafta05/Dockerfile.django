FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY django_demo/requirements.txt /app/django_demo/requirements.txt
RUN pip install --no-cache-dir -r /app/django_demo/requirements.txt
COPY django_demo /app/django_demo
EXPOSE 8001
CMD ["sh", "-c", "cd /app/django_demo && python manage.py migrate --noinput && python manage.py runserver 0.0.0.0:8001 --noreload"]
