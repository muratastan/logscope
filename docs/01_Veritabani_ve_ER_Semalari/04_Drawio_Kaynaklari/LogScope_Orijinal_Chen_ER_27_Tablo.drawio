        </mxCell>
        <mxCell id="note_00604" value="Tablolar ayri mini-paneller halinde degildir. Her eskenar dortgen dogrudan iki gercek varliga baglanir." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#62798B;" vertex="1" parent="1">
