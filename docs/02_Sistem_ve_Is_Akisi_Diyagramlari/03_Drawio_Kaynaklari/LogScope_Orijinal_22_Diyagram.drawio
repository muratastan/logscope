        <mxCell id="title_00601" value="&lt;b&gt;LOGSCOPE  |  TEK BAGLI KLASIK CHEN ER DIYAGRAMI&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=38;fontColor=#1C3753;" vertex="1" parent="1">
          <mxGeometry x="175.0" y="33.0" width="6574" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="note_00602" value="27 varlik (dikdortgen)  |  225 oznitelik (oval)  |  41 iliski (eskenar dortgen)  |  TEK BAGLI AG" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#62798B;" vertex="1" parent="1">
          <mxGeometry x="175.0" y="128.0" width="6574" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="note_00603" value="Sari oval: PK   |   Yesil oval: FK   |   Mor oval/kesikli iliski: istege bagli FK   |   Alt cizgili oval: birincil anahtar   |   N / 1: cokluk" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#62798B;" vertex="1" parent="1">
          <mxGeometry x="175.0" y="180.0" width="6574" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="note_00604" value="Tablolar ayri mini-paneller halinde degildir. Her eskenar dortgen dogrudan iki gercek varliga baglanir." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#62798B;" vertex="1" parent="1">
          <mxGeometry x="175.0" y="230.0" width="6574" height="42" as="geometry"/>
        </mxCell>
      </root>
