        </mxCell>
        <mxCell id="page00_s1" value="İP1 • 1. Hafta&lt;br/&gt;Use case · Sistem · AI hattı&lt;br/&gt;Hata dallı akışlar" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#537CA4;strokeWidth=2;fontColor=#234055;fontSize=27;fontStyle=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
