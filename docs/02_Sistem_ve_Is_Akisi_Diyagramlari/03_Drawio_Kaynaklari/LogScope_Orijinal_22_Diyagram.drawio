        <mxCell id="page00_sub" value="Murat Astan · Elif Feyza Ünal   |   Fırat Üniversitesi · Yapay Zekâ ve Veri Mühendisliği Tasarımı" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#234055;fontSize=19;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=middle;" vertex="1" parent="1">
