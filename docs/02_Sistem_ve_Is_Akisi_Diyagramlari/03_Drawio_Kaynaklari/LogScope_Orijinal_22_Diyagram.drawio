        </mxCell>
        <mxCell id="page00_s3" value="Ek teknik görünümler&lt;br/&gt;Deney ayrımı · Sequence&lt;br/&gt;Depo ve ekran navigasyonu" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF3DD;strokeColor=#BB9046;strokeWidth=2;fontColor=#234055;fontSize=25;fontStyle=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="1320" y="400" width="650" height="290" as="geometry"/>
        </mxCell>
        <mxCell id="page00_note" value="Tüm oklar, kutular, karar düğümleri, model ve veri alanları Draw.io üzerinde ayrı ayrı düzenlenebilir.&lt;br/&gt;Şekil 1 çevrim dışı eğitim ve çevrim içi izleme akışını içerir.&lt;br/&gt;Veri tabanı sayfası önceki onaylanan 27 tabloluk Chen ER çiziminden alınmıştır." style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#234055;fontSize=24;fontStyle=0;fontFamily=Arial;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="170" y="805" width="1700" height="240" as="geometry"/>
        </mxCell>
