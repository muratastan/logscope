        </mxCell>
        <mxCell id="page00_s2" value="İP2 • 2. Hafta&lt;br/&gt;ER · JSONL middleware&lt;br/&gt;Veri sözlüğü" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E5F6F0;strokeColor=#3E947D;strokeWidth=2;fontColor=#234055;fontSize=27;fontStyle=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1">
